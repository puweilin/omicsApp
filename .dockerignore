# Build context is the repository root (see deploy/docker/Dockerfile),
# so everything not needed to install the two packages is excluded --
# otherwise the whole git history and the mockups ship to the daemon on
# every build.
.git
.github
.claude
docs
mockup
.DS_Store

# deploy/docker is kept: prewarm_genesets.R and check_cjk_pdf.R are
# COPY'd from it. Nothing else in deploy/ is, and two of the directories
# below hold secrets on a configured server -- the Keycloak .env with the
# admin and database passwords, and host.env with the address. Nothing
# COPYs them, so they were never in the image; keeping them out of the
# build context means they are not sent to the daemon either, which is
# one fewer place a secret has been.
deploy/nginx
deploy/scripts
deploy/shinyproxy
deploy/keycloak
deploy/cron
deploy/README.md
deploy/host.env
deploy/host.env.template
deploy/rsync.exclude

# R build artefacts
**/.Rproj.user
**/*.Rproj
**/*.Rcheck
**/*.tar.gz
**/.Rhistory
**/.RData
packages/*/docs
