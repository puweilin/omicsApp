# Settings for deploy/scripts/backup.sh and restore_check.sh.
#
#   sudo mkdir -p /etc/omicsapp
#   sudo cp deploy/backup.env.template /etc/omicsapp/backup.env
#   sudo chmod 600 /etc/omicsapp/backup.env
#   sudo $EDITOR /etc/omicsapp/backup.env
#
# Every line is optional; the defaults are the layout deploy/README.md
# describes. Kept outside the repository: it names your other machine and
# your alert channel.

# Where the snapshots go on this host -- a different physical disk from
# the data.
BACKUP_ROOT=/backup/omicsapp

# Another machine, reached with ssh keys (no password prompt under cron):
# user@backup-host:/srv/backup/omicsapp. Without it the only copy is on
# the same host as the data, and a fire, theft or OS reinstall takes both.
BACKUP_REMOTE=

# How long to keep: every snapshot for KEEP_DAILY days, then one per
# week for KEEP_WEEKLY weeks.
KEEP_DAILY=14
KEEP_WEEKLY=8

# Who hears about a failure. A Slack/Teams/DingTalk-style incoming
# webhook that accepts {"text": "..."}, and/or an address for `mail`.
ALERT_WEBHOOK=
ALERT_EMAIL=

# The checkout the service was deployed from (its rendered configs are
# backed up) and the image it runs.
REPO_DIR=/opt/omicsApp
APP_IMAGE=omicsapp:1.0

# Data locations -- change only if you moved them.
USERS_DIR=/srv/omicsapp/users
KEYCLOAK_DB_DIR=/srv/omicsapp/keycloak-db
GENESETS_DIR=/srv/omicsapp/genesets
KEYCLOAK_CONTAINER=keycloak-db

# restore_check.sh: alert when the newest backup is older than this.
MAX_AGE_HOURS=36
