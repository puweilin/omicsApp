# Secrets for the Keycloak stack.
#
#   cp .env.template .env
#   chmod 600 .env
#   # fill in the two values, then: sudo docker compose up -d
#
# .env is gitignored. Generate the values on the server -- a password
# that has been pasted into a chat window or an editor on a laptop is a
# password with copies you cannot account for:
#
#   LC_ALL=C head -c 256 /dev/urandom | base64 | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32; echo

# Postgres. Only Keycloak ever uses it. Nothing reads this after the
# database is created, so it can be long and unmemorable.
KC_DB_PASSWORD=REPLACE_ME

# The bootstrap admin for Keycloak's own console -- this is you, not an
# omicsApp user. Read only while the database is empty; afterwards the
# account lives in Postgres and this line does nothing.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=REPLACE_ME
