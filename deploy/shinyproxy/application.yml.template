# ShinyProxy configuration for omicsApp.
#
# Copy to application.yml on the server, fill in the users, and keep it
# out of git -- .gitignore already excludes application.yml. Even in a
# private repository a password committed once stays in the history.
#
#   cp application.yml.template application.yml
#   chmod 600 application.yml
#
# Written for ShinyProxy 3.1.1. The `openid` backend long predates it,
# so this needs no upgrade -- unlike `customHeader`, which arrived in
# 3.2.0 and would also drag Java 17 up to 21.

proxy:
  port: 8080
  # Bind to localhost only; nginx terminates the connection from users.
  bind-address: 127.0.0.1

  # ---- authentication -------------------------------------------------
  # Keycloak owns the credentials; ShinyProxy only trusts what it says.
  # That is what makes self-service possible: a user changes their own
  # password and username in Keycloak's account console, and nothing
  # here has to be edited or restarted.
  #
  # `openid`, not `keycloak`: the dedicated Keycloak backend was
  # deprecated in 3.0.2 and removed in 3.1.0.
  authentication: openid
  admin-groups: [admins]
  openid:
    auth-url:  https://192.168.51.52/auth/realms/omicsapp/protocol/openid-connect/auth
    token-url: https://192.168.51.52/auth/realms/omicsapp/protocol/openid-connect/token
    jwks-url:  https://192.168.51.52/auth/realms/omicsapp/protocol/openid-connect/certs
    logout-url: https://192.168.51.52/auth/realms/omicsapp/protocol/openid-connect/logout
    client-id: shinyproxy
    client-secret: REPLACE_ME

    # This one line decides whether anyone keeps their data.
    #
    # It names the claim that becomes proxy.userId, which names the
    # volume below. The default is `email`, and `preferred_username` is
    # the obvious-looking choice -- but users are allowed to change both
    # of those, and the day someone does, their volume points somewhere
    # new and their projects are gone.
    #
    # `sub` is the only claim Keycloak guarantees never changes. The
    # cost is that the directories are UUIDs rather than names; see
    # deploy/scripts/list_users.sh for the mapping back.
    username-attribute: sub

    # Group membership arrives as a claim, not from a directory lookup,
    # so the realm needs a group-membership mapper emitting `groups`.
    # Without it every login succeeds and then fails authorization,
    # because access-groups below matches nothing.
    roles-claim: groups

    # nginx terminates TLS, so the request reaching ShinyProxy is plain
    # HTTP and Spring builds an http:// redirect URI from it -- which
    # Keycloak rejects, because the registered one is https://. This
    # forces the scheme.
    enforce-https-redirect-uri: true

  # ---- session lifecycle ----------------------------------------------
  # ShinyProxy has no idle detection: a tab left open counts as active
  # forever. heartbeat-timeout therefore only catches a *closed* tab,
  # and max-lifetime is the only thing that reclaims a forgotten one.
  #
  # 30 minutes rather than the 60s default: a laptop lid, a lift, or a
  # VPN reconnect must not cost a session. The app autosaves on every
  # project change, so a reaped container costs a page reload.
  heartbeat-rate: 10000
  heartbeat-timeout: 1800000

  # 24h, not 8h: max-lifetime stops a container regardless of whether
  # someone is using it, so a short value would cut off a long working
  # day mid-analysis.
  default-proxy-max-lifetime: 1440
  default-stop-proxy-on-logout: true

  docker:
    internal-networking: true

  specs:
    - id: omicsapp
      display-name: Multi-omics analysis
      description: Proteomics and transcriptomics QC, differential analysis, enrichment, and integration
      container-image: omicsapp:1.0
      container-network: sp-net
      port: 3838
      # A single analysis holds the matrices plus every computed bundle.
      # 6g is generous for 20k x 60; raise it before raising the number
      # of users if the data grows.
      container-memory-limit: 6g
      container-cpu-limit: 2
      # #{proxy.userId} is substituted per login -- this is what makes
      # each user's projects private. The host directory must exist and
      # be owned by the container's uid *before* first login: Docker
      # creates a missing bind-mount source as root, and the container
      # cannot write to it. deploy/scripts/add_user.sh does this.
      #
      # One mount. Which physical disk it lands on is a mount point on
      # the host, not something this file should know: /srv is the HDD
      # (see the README's storage layout). Encoding the disk here would
      # mean editing configuration to move data, and the two would drift.
      #
      # Splitting projects and archived uploads across disks is possible
      # -- Docker orders bind mounts by depth, so a nested
      # `.../raw/#{proxy.userId}:/data/raw` lands on top of this one and
      # the app still sees a single tree. Not worth it here: the whole
      # store grows ~75 GB a year and the HDD holds 60 TB.
      container-volumes:
        - "/srv/omicsapp/users/#{proxy.userId}:/data"
      container-env:
        OMICSAPP_QUOTA_GB: "50"
      access-groups: [lab, admins]

      # Deliberately no `minimum-seats-available`. It looks attractive
      # -- keep a container warm so the first user of the day does not
      # wait for a 7 GB image -- but it cannot coexist with the volume
      # above. Pre-initialized containers are created at startup, before
      # anyone has logged in, so ShinyProxy cannot fill in a per-user
      # value; the documentation says so outright: "the container cannot
      # be customized for a specific user. This means that you cannot
      # use SpEL expression in the configuration of an app."
      #
      # Private per-user storage is the whole point here, so the warm
      # container is what gets dropped. Do not add this back without
      # first working out where #{proxy.userId} would resolve to.

# ShinyProxy is a Spring Boot application and runs a second server for
# the actuator endpoints, on 9090 by default. On a shared machine that
# is as likely to be occupied as 8080, and when it cannot bind, the
# whole context fails to start -- after the main port has already come
# up, so the log says "Undertow started on port 8081" and then "Web
# server failed to start", which reads like a contradiction.
#
# Check both before starting:
#   sudo ss -tln | grep -E ':(8080|9090) '
management:
  server:
    port: 9091

logging:
  file:
    name: /var/log/shinyproxy/shinyproxy.log

server:
  servlet:
    session:
      # Must not be shorter than proxy.heartbeat-timeout above, or the
      # session expires first and the longer heartbeat never applies.
      timeout: 2h
