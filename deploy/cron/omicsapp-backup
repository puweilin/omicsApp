# Nightly backup and weekly restore drill for omicsApp.
#
#   sudo cp deploy/cron/omicsapp-backup /etc/cron.d/omicsapp-backup
#   sudo chmod 644 /etc/cron.d/omicsapp-backup   # cron ignores other modes
#
# Settings live in /etc/omicsapp/backup.env (see deploy/backup.env.template);
# the scripts read it themselves. What is backed up, and why each part
# matters, is written at the top of deploy/scripts/backup.sh. In short:
# /srv/omicsapp/users/ (the work), the Keycloak database (who may open
# it -- without it a restore gives you every file and nobody who can log
# in), the rendered configuration, the TLS certificate and the gene-set
# cache; as dated, checksummed snapshots, copied off the host when
# BACKUP_REMOTE is set, with an alert on any failure.
#
# The scripts are run from the deployed checkout (REPO_DIR, default
# /opt/omicsApp). Output goes to a log as well as to the alert hook, so
# a failure leaves a trace even when the hook itself is down.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Every night at 02:20.
20 2 * * *  root  /opt/omicsApp/deploy/scripts/backup.sh >> /var/log/omicsapp-backup.log 2>&1

# Sundays at 04:10: restore the latest snapshot into throwaway containers
# and check it, and alert if no backup has finished in 36 hours.
10 4 * * 0  root  /opt/omicsApp/deploy/scripts/restore_check.sh >> /var/log/omicsapp-backup.log 2>&1
