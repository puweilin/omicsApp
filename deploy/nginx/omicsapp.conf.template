# nginx front end for omicsApp: ShinyProxy at /, Keycloak at /auth.
#
# deploy/scripts/render.sh writes omicsapp.conf from this template, with
# @OMICSAPP_HOST@ replaced by the address in deploy/host.env. Edit the
# template; the rendered file is gitignored.
#
#   sudo cp omicsapp.conf /etc/nginx/sites-available/omicsapp
#   sudo ln -s /etc/nginx/sites-available/omicsapp /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Shiny talks over a WebSocket. Without the Upgrade/Connection headers
# below the page loads and then hangs with a greyed-out UI -- the single
# most common way a Shiny deployment behind a proxy fails.
#
# ---- the certificate ------------------------------------------------
# HTTPS is not optional once Keycloak is in the path: it refuses to
# serve a non-local hostname over plain HTTP, and login tokens should
# not cross even a lab network in the clear. On a LAN a self-signed
# certificate is enough -- browsers warn once, then remember:
#
#   sudo openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
#     -keyout /etc/ssl/private/omicsapp.key \
#     -out /etc/ssl/certs/omicsapp.crt \
#     -subj "/CN=@OMICSAPP_HOST@" \
#     -addext "subjectAltName=@OMICSAPP_HOST_SAN@,DNS:omics.local,DNS:omics"
#
# The subjectAltName is not decoration. Java validates the address it
# connected to against the SAN list and ignores CN entirely, so a
# certificate without `@OMICSAPP_HOST_SAN@` fails the next step.
#
#   sudo cp /etc/ssl/certs/omicsapp.crt /usr/local/share/ca-certificates/
#   sudo update-ca-certificates
#   sudo systemctl restart shinyproxy
#
# That step is easy to skip and expensive to debug. ShinyProxy is a Java
# process that fetches tokens and signing keys from Keycloak directly --
# server to server, not through the browser -- and Java trusts its own
# keystore rather than the system one. Without it the browser login
# looks perfect and ShinyProxy then fails the callback with a TLS error
# buried in a stack trace. On Debian and Ubuntu, update-ca-certificates
# is what copies the certificate into /etc/ssl/certs/java/cacerts.

# ---- administrative endpoints: from the allow-list only --------------
# Keycloak's admin console and admin API (/auth/admin/), the master
# realm its administrator logs in through (/auth/realms/master/),
# Keycloak's health and metrics paths, ShinyProxy's admin page (/admin)
# and Spring's actuator paths are served to the addresses below and
# refused (403) to everyone else. Users never need any of them: their
# own account page is /auth/realms/omicsapp/account, which stays open.
#
# The list is ADMIN_ALLOW_CIDR in deploy/host.env, written here by
# deploy/scripts/render.sh. Its default is the server itself --
# 127.0.0.1, ::1 and the server's own address -- so from a workstation
# either add that workstation's address there and re-render, or reach
# the console through the server (`ssh -D 1080 <server>`, then the
# browser's SOCKS proxy set to localhost:1080). See deploy/README.md.
#
# `geo` and `map` sit at http level (this file is included inside the
# http block), hence outside the server blocks. $uri is the normalised
# path -- percent-decoded, `//` merged -- which is also what proxy_pass
# forwards, so `/auth//admin` or `/auth/%61dmin` cannot slip past a
# check that the backend would then read differently.
geo $omicsapp_admin_client {
    default 0;
    @OMICSAPP_ADMIN_ALLOW@
}

map $uri $omicsapp_admin_path {
    default 0;
    ~*^/auth/admin(/.*)?$              1;
    ~*^/auth/realms/master(/.*)?$      1;
    ~*^/auth/(health|metrics)(/.*)?$   1;
    ~*^/admin(/.*)?$                   1;
    ~*^/actuator(/.*)?$                1;
}

map "$omicsapp_admin_path:$omicsapp_admin_client" $omicsapp_admin_denied {
    default 0;
    "1:0"   1;
}

# ---- rate limits --------------------------------------------------------
# Two budgets per client address, both answered with 429 when spent:
#
#   omicsapp_login    the password form (Keycloak's login-actions) and
#                     the token endpoint: 10 a minute after a burst of
#                     10. A person signing in uses two or three; a script
#                     guessing passwords is slowed to a crawl before
#                     Keycloak's own lockout (bruteForceProtected in the
#                     realm) even counts it. That lockout is per account;
#                     this is per address, so it also covers guessing
#                     across many accounts.
#   omicsapp_general  everything else: 20 a second after a burst of 200,
#                     with no delay inside the burst. Opening the app
#                     fetches some dozens of scripts and stylesheets at
#                     once, which the burst absorbs; only a flood
#                     notices the limit.
#
# Shiny's WebSocket is exempt. limit_req counts requests, and a
# WebSocket is one request (the upgrade) that then carries every input
# and every update for hours, so its traffic is never counted anyway --
# but a tab that reconnects in a loop after a network blip would spend
# the budget of the person using it, and the result would be a greyed-out
# app with a 429 nobody sees. Upgrades therefore get an empty key, which
# nginx does not count.
#
# The server itself is exempt too: ShinyProxy fetches tokens and signing
# keys from Keycloak through this nginx (its token-url is the public
# https:// address), from the server's own address, on behalf of every
# user at once. Counting that against one address would lock everyone
# out of signing in together. The list is RATE_LIMIT_EXEMPT_CIDR in
# deploy/host.env, rendered by deploy/scripts/render.sh; unset, it is
# 127.0.0.1, ::1 and the server's own address.
geo $omicsapp_rate_exempt {
    default 0;
    @OMICSAPP_RATE_EXEMPT@
}

map $http_upgrade $omicsapp_is_upgrade {
    default 1;
    ""      0;
}

map $omicsapp_rate_exempt $omicsapp_login_key {
    default $binary_remote_addr;
    1       "";
}

map "$omicsapp_rate_exempt:$omicsapp_is_upgrade" $omicsapp_general_key {
    default "";
    "0:0"   $binary_remote_addr;
}

limit_req_zone $omicsapp_login_key   zone=omicsapp_login:10m   rate=10r/m;
limit_req_zone $omicsapp_general_key zone=omicsapp_general:10m rate=20r/s;

server {
    listen 80;
    server_name omics.local omics @OMICSAPP_HOST@;

    # Everything is behind Keycloak now, so there is nothing left that
    # is safe to serve over plain HTTP.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    # No HTTP/2, deliberately. `http2 on;` is nginx 1.25.1+ syntax and
    # fails to parse on anything older, and the older `listen ... http2`
    # form is deprecated on anything newer -- so either spelling breaks
    # on half the versions this might be deployed to.
    #
    # There is also nothing to gain. The critical path here is Shiny's
    # WebSocket, and carrying a WebSocket over HTTP/2 needs RFC 8441 on
    # both ends: a second variable in the one place this deployment is
    # most likely to fail, bought for a handful of parallel asset
    # requests at four users.

    # Answers to whichever name resolves. The IP is kept last on purpose:
    # when a name stops resolving, users report "it's broken" rather than
    # "DNS is broken", and having the address still work tells you which
    # of the two it was.
    #
    # `omics.local` needs avahi on the server and nothing on the clients:
    #     sudo apt-get install -y avahi-daemon
    #     sudo hostnamectl set-hostname omics
    # mDNS does not cross subnets. If the institution runs DNS, an A
    # record beats this and works everywhere -- list both, they do not
    # conflict.
    server_name omics.local omics @OMICSAPP_HOST@;

    ssl_certificate     /etc/ssl/certs/omicsapp.crt;
    ssl_certificate_key /etc/ssl/private/omicsapp.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # This site's own logs, beside nginx's: the distribution's logrotate
    # already rotates /var/log/nginx/*.log, and backup.sh keeps
    # /var/log/nginx in every snapshot.
    access_log /var/log/nginx/omicsapp.access.log;
    error_log  /var/log/nginx/omicsapp.error.log;

    # Administrative paths from the allow-list only (see the top of this
    # file). Server-level, so it covers both locations below. `return`
    # is one of the two directives that are safe inside `if`.
    if ($omicsapp_admin_denied) {
        return 403;
    }

    # The general budget (see "rate limits" at the top). Server-level, so
    # it covers every location that does not set limit_req itself -- nginx
    # inherits limit_req only into blocks that have none of their own,
    # which is why the login location below repeats it.
    limit_req zone=omicsapp_general burst=200 nodelay;
    limit_req_status 429;
    limit_req_log_level warn;

    # No nginx version in error pages and the Server header.
    server_tokens off;

    # ---- security headers ---------------------------------------------
    # Repeated in each location below rather than set here, on purpose:
    # nginx drops every server-level add_header in a location that has
    # an add_header of its own, so a header written once here would
    # silently vanish from both. test-deploy-contract.R checks that the
    # two locations agree. `always` adds them to error responses (403,
    # 429, 502) too.
    #
    # Strict-Transport-Security: a browser that has seen it goes straight
    # to https:// for a year, so a link or a typed http:// address can no
    # longer be intercepted on the way to the redirect. No
    # includeSubDomains and no preload: this server does not own its
    # parent domain's other names, and a preload entry takes months to
    # undo. Browsers ignore the header on a bare IP address and over a
    # certificate they had to be told to accept, so on a LAN with a
    # self-signed certificate it does nothing until a real certificate
    # is in place -- which is when it starts to matter. ShinyProxy
    # (Spring Security) and Keycloak each send their own, with
    # includeSubDomains; proxy_hide_header drops theirs so the browser
    # sees exactly one policy, this one.

    # Omics workbooks are large; the app accepts up to 500 MB
    # (omicsApp::launch(max_upload_mb =)), so nginx must not cut in
    # below that.
    client_max_body_size 550M;

    # An import parses the whole workbook before responding. The default
    # 60s read timeout would abort a large upload mid-parse.
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # ---- Keycloak ---------------------------------------------------
    # Listed before `location /` for readability only; nginx matches the
    # longest prefix regardless of order.
    #
    # Keycloak serves under /auth too (KC_HTTP_RELATIVE_PATH), so the
    # path is identical on both sides and nothing rewrites it. A
    # trailing-slash mismatch between these two lines would strip the
    # prefix and every URL Keycloak generates would 404.
    location /auth/ {
        proxy_pass http://127.0.0.1:8180/auth/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Keycloak builds every redirect and the token issuer from these.
        # With KC_PROXY_HEADERS=xforwarded and no X-Forwarded-Proto it
        # decides it is running on http, hands the browser an http:// URL
        # and then rejects it -- or answers 403 outright, because its
        # origin check compares against the wrong scheme.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;

        # Tokens carrying group claims outgrow the 4k default, and the
        # symptom is a 502 on the callback rather than anything about
        # header size.
        proxy_buffer_size   16k;
        proxy_buffers       8 16k;

        # Security headers (see above the locations). Keycloak sets its
        # own X-Frame-Options, Content-Security-Policy and
        # Referrer-Policy per realm (Realm settings > Security defenses),
        # tuned to what its login pages and admin console need, so those
        # are left to it; nginx adds only what Keycloak does not, and
        # replaces its HSTS so there is one policy for the whole site.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Permissions-Policy;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

        # The password form and the token endpoint get the tight login
        # budget as well as the general one (see "rate limits" at the
        # top). Nested, so it inherits the proxy settings and headers
        # above; only proxy_pass is not inherited, and in a regex
        # location it may not carry a path -- none is needed, the path is
        # the same on both sides. Loading the login page is not limited:
        # posting the password is what is counted.
        location ~ ^/auth/realms/[^/]+/(login-actions/|protocol/openid-connect/token) {
            limit_req zone=omicsapp_login burst=10 nodelay;
            limit_req zone=omicsapp_general burst=200 nodelay;
            proxy_pass http://127.0.0.1:8180;
        }
    }

    # ---- ShinyProxy -------------------------------------------------
    # 8081 must match `proxy.port` in application.yml. They are two
    # files that have to agree, and disagreeing is quiet: 8080 on this
    # host belongs to a colleague's service, so nginx forwards there and
    # users get a 401 from software they have never heard of.
    location / {
        proxy_pass http://127.0.0.1:8081;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # ShinyProxy builds its OIDC redirect URI from the request. This
        # is what makes it say https, together with
        # proxy.openid.enforce-https-redirect-uri in application.yml --
        # otherwise it registers http:// and Keycloak refuses it.
        proxy_set_header X-Forwarded-Proto $scheme;

        # Analysis output streams as it is produced; buffering it would
        # make progress indicators arrive all at once at the end.
        proxy_buffering off;
        proxy_redirect off;

        # Security headers (see above the locations). The upstream's own
        # copies are hidden so each header is sent once, with one value.
        #
        # Framing: ShinyProxy shows each app inside an iframe of its own
        # page (/app/<id> frames /app_proxy/<container>/), on this same
        # origin, so SAMEORIGIN -- DENY would leave a blank page under
        # the navigation bar. No other site may frame any of it, which is
        # what stops a page elsewhere from overlaying the app and
        # steering clicks.
        #
        # The Content-Security-Policy is in two parts. The enforced one
        # holds only what is known to be safe for Shiny and ShinyProxy:
        # framing by this origin, no plugins, no <base> rewriting. The
        # full policy is Report-Only: browsers block nothing and log what
        # it would have blocked in the developer console. Shiny needs
        # inline scripts and styles, htmlwidgets (DT, plotly) evaluate
        # JavaScript from strings, and ShinyProxy's pages carry inline
        # script of their own, so the policy needs 'unsafe-inline' and
        # 'unsafe-eval' and may still miss something -- enforcing it
        # untested would risk a page that loads and then does nothing.
        # Once the console stays clean through a full session (import,
        # analyses, report download, sign out), drop the -Report-Only;
        # see "Security headers and rate limits" in deploy/README.md.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
