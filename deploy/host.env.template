# The server's address, written once.
#
# Four deployment files carry it -- nginx's server_name and certificate,
# Keycloak's KC_HOSTNAME, the realm's redirect URIs, ShinyProxy's OIDC
# endpoints -- and they have to agree. deploy/scripts/render.sh reads
# this file and writes all four from their .template neighbours.
#
#   cp deploy/host.env.template deploy/host.env
#   $EDITOR deploy/host.env
#   deploy/scripts/render.sh
#
# host.env is gitignored and excluded from the rsync in the README: it
# describes your server, not the software.
#
# An IP address or a DNS name, exactly as users will type it into the
# browser and as the TLS certificate's subjectAltName carries it. No
# scheme, no port, no path.
OMICSAPP_HOST=REPLACE_ME
