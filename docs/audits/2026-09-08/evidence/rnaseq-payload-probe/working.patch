--- a/packages/omicsCore/R/diff-design.R
+++ b/packages/omicsCore/R/diff-design.R
@@ -67,6 +67,33 @@ safe_frame <- function(meta, terms) {
 #'
 #' @param meta Sample metadata.
 #' @param terms Model terms, in order; the first is normally the primary one.
+#' A formula that does not carry the frame it was built in
+#'
+#' `stats::as.formula()` on a string takes `env = parent.frame()`, and a
+#' formula holds its environment for as long as anything holds the formula.
+#' That is fine for a formula consumed and dropped, and a leak for one that
+#' is stored: DESeq2 keeps the design inside the `DESeqDataSet`, so the
+#' object returned by `run_deseq2_group()` referred back to that function's
+#' frame -- which by the time it returned held the subsetted count matrix,
+#' the standardized results, and the `DESeqDataSet` itself. A cycle.
+#'
+#' Measured at 63k features x 12 samples: 39 MB of actual data, 131 MB once
+#' the environment is followed, of which the formula accounted for 98 MB.
+#' `object.size()` does not follow environments and so reported the first
+#' number; `future` does, and refused to send the bundle to a worker.
+#'
+#' The design terms are columns of the data frame passed alongside, so
+#' nothing is ever looked up in the formula's environment. `baseenv()`
+#' rather than `emptyenv()`, because code that calls `environment(f)` on a
+#' formula expects something it can search.
+#'
+#' @param text The formula, as a string.
+#' @keywords internal
+#' @noRd
+detached_formula <- function(text) {
+  stats::as.formula(text, env = baseenv())
+}
+
 #' @param primary Which of `terms` carries the contrast, if any.
 #' @param intercept Include an intercept column.
 #'
diff --git a/packages/omicsCore/R/qc-rnaseq.R b/packages/omicsCore/R/qc-rnaseq.R
index 33f0d0e..3cec8f0 100644
--- a/packages/omicsCore/R/qc-rnaseq.R
+++ b/packages/omicsCore/R/qc-rnaseq.R
@@ -1,3 +1,42 @@
+#' Which features are too lowly expressed to test
+#'
+#' Keeps a feature when at least `min_samples` samples reach `min_count`,
+#' the filter edgeR and DESeq2 both ask for and spell the same way. It is
+#' deliberately not "total counts across all samples": a gene at 200 in one
+#' sample and zero everywhere else passes that and cannot support a
+#' contrast.
+#'
+#' Two reasons to run it, and the second is the one people forget. A
+#' feature nobody detected carries no information about any contrast, and
+#' fitting a model for it costs exactly what fitting a real one costs -- on
+#' a full human index roughly a fifth of the rows are zero in every sample.
+#' And every one of them still enters the multiple-testing correction, so
+#' testing them makes the real findings harder to detect rather than
+#' easier.
+#'
+#' Returns the features to *drop*, so the caller can union it with whatever
+#' else it is dropping.
+#'
+#' @param count_mat Counts, features x samples.
+#' @param min_count The count a sample must reach to be counted.
+#' @param min_samples How many samples must reach it.
+#'
+#' @return Character vector of feature ids failing the filter.
+#' @keywords internal
+#' @noRd
+low_expression_features <- function(count_mat, min_count, min_samples) {
+  if (!is.numeric(min_count) || !is.numeric(min_samples) ||
+      min_count <= 0 || min_samples <= 0) {
+    return(character(0))
+  }
+  # NA counted as not reaching the threshold. A missing count is not a
+  # detection, and treating it as one is how an all-NA row survives a
+  # filter whose whole purpose is to remove rows with nothing in them.
+  reached <- rowSums(!is.na(count_mat) & count_mat >= min_count)
+  ids <- rownames(count_mat) %||% as.character(seq_len(nrow(count_mat)))
+  ids[reached < min_samples]
+}
+
 #' Winsorize per-gene outliers in a count matrix
 #'
 #' For each gene (row), values exceeding `Q3 + k * IQR` are clipped to that
